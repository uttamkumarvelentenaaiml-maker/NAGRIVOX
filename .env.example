# NAGRIVOX Environment Configuration

PORT=3000
NODE_ENV=development

# Gemini API Key (Required for AI Chat & Multi-modal extraction)
GEMINI_API_KEY=

# Backend PostgreSQL & Redis
DATABASE_URL=postgresql://nagrivox:nagrivox_pass@localhost:5432/nagrivox_db
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=nagrivox_secure_jwt_secret_dev_key_2026
JWT_EXPIRATION_HOURS=24

# S3/Cloud Storage (Production)
STORAGE_BUCKET=nagrivox-citizen-vault
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
